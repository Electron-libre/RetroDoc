{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run -p retrodoc-cli *)",
      "Bash(cargo check *)",
      "Bash(just)",
      "Bash(just *)",
      "Bash(rust-script .claude/*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git check-ignore)",
      "Bash(git check-ignore *)",
      "Bash(git grep)",
      "Bash(git grep *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(cardinal run *)"
    ],
    "deny": [
      "Bash(just waive-review)",
      "Bash(just waive-review *)",
      "Edit(//**/claude-review-waived)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run format-code"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run review-gate record"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run language-hint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run lint-gate",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "cardinal run language-hint",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run review-gate check"
          }
        ]
      }
    ]
  }
}
